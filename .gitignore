# ----------------------------------------
# Global default - ignore everything, whitelist essential project files
# ----------------------------------------
/*

# Whitelisted project files and directories required in repo
!/.github
!/build-aux
!/cmake
!/data
!/doc
!/docs
!/src
!/tests
!/tools
!/util
!/.mcp
!.clang-format
!.gersemirc
!.gitignore
buildspec.json
CMakeLists.txt
CMakePresets.json
local-build.bat
local-build.sh
LICENSE
README.md
AGENTS.md

# Optional private folder (not present in public sync)
!private

# ----------------------------------------
# Editor, environment and lock files
# ----------------------------------------
# Exclude Visual Studio Code settings directory
.vscode

# Lock and machine-specific files
*.lock.json
compile_commands.json

# macOS metadata
.DS_Store

# Backup and transient files
*.backup
*.log
*.tmp
obs_log.txt

# ----------------------------------------
# Build outputs and artifacts
# ----------------------------------------
# C64 build outputs
*.prg
*.lst

# Prebuilt PRGs that must remain tracked for packaging
!data/prg/*.prg

# CMake build number cache
/cmake/.CMakeBuildNumber

# Build directories and generic build artifacts
build_*/
tests/build*

# CMake generated files (global)
CMakeFiles/
CMakeCache.txt
CTestTestfile.cmake
Makefile
cmake_install.cmake
Testing/

# Test build artifacts
tests/CMakeFiles/
tests/Testing/
tests/CMakeCache.txt
tests/CTestTestfile.cmake
tests/Makefile
tests/cmake_install.cmake

# ----------------------------------------
# Test-related generated files and outputs
# ----------------------------------------
# Script test artifacts
tests/script/scripts/config.ini
tests/script/scripts/execution_log.txt
tests/script/scripts/loop_output.txt
tests/script/scripts/numbers.txt
tests/script/scripts/relative-output.txt
tests/script/scripts/test_data.txt
tests/script/scripts/test_log_default_path.log

# Keep only source files under tests tracked
!/tests/*.c
!/tests/*.h
!/tests/CMakeLists.txt

# E2E scenario generated artifacts and packet outputs
tests/e2e/scenarios/*/generated/
tests/e2e/test_output_*/
tests/e2e/test_packets_*/

# E2E run artifacts (recordings, perf, logs)
tests/e2e/results/**/flamegraph.svg
tests/e2e/results/**/perf.data
tests/e2e/results/**/perf.folded
tests/e2e/results/**/perf_report.txt
tests/e2e/results/**/perf_record_stdout.txt
tests/e2e/results/**/perf_record_stderr.txt
tests/e2e/results/**/obs_log.txt
tests/e2e/results/**/obs_log_summary.json
tests/e2e/results/**/*.mp4
tests/e2e/results/**/*.mk4
tests/e2e/results/**/*.mkv
tests/e2e/results/**/video_manifest.csv
tests/e2e/results/**/audio_manifest.csv

# Local-only archived E2E snapshots (baseline comparisons)
tests/e2e/results-archive/

# ----------------------------------------
# Tools and third-party utilities
# ----------------------------------------
# Python cache for tools
tools/__pycache__/

# FlameGraph and test-patterns installed by helper scripts
tools/FlameGraph/
tools/test-patterns

# ----------------------------------------
# Security and secrets
# ----------------------------------------
.secrets

# Palette Showcase
# Displays each available palette for 5 seconds

# Default Colodore palette
palette colodore
wait 5s

# VICE palettes
palette vice
wait 5s

palette vice_new
wait 5s

# Pepto palettes
palette pepto_ntsc
wait 5s

palette pepto_pal
wait 5s

palette pepto_ntsc_sony
wait 5s

# Community palettes
palette community_colors
wait 5s

palette pixcen
wait 5s

# Retro palettes
palette ccs64
wait 5s

palette frodo
wait 5s

palette godot
wait 5s

# Return to default
palette colodore
wait 2s

stop

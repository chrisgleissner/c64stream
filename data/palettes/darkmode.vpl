# VICE Palette file
#
# Syntax:
# Red Green Blue
#
# TYPE:VICII
# NAME:Dark Mode
# DESC:Modern dark mode - C64 login screen appears with dark grey border, black background, bright blue text

00 00 00  # Black -> Pure black (background)
E8 E8 E8  # White -> Light gray text
FF 4D 4D  # Red -> Bright red accent
00 D4 D4  # Cyan -> Bright cyan accent
C9 6B D7  # Purple -> Vibrant purple
00 DD 00  # Green -> Bright green accent
3D 3D 3D  # Blue -> Dark grey (border)
FF DD 00  # Yellow -> Bright yellow accent
FF 99 00  # Orange -> Bright orange accent
BB 66 33  # Brown -> Warm brown
FF 88 BB  # Pink -> Bright pink accent
2A 2A 2A  # DarkGrey -> Very dark gray
5A 5A 5A  # MedGrey -> Medium gray
88 FF 88  # LightGreen -> Bright mint green
66 99 FF  # LightBlue -> Bright blue (text)
C0 C0 C0  # LightGrey -> Light gray

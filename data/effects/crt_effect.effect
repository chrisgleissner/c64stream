// Platform detection for shader compilation
static const bool obs_glsl_compile = false; // DirectX 11 by default, overridden by OBS for OpenGL

// Uniforms
uniform float4x4 ViewProj;
uniform texture2d image;

// CRT effect parameters
uniform float scan_line_distance;      // Gap between scan lines as percentage of line height (0.0-2.0)
uniform float scan_line_strength;      // Darkness of gaps (0.0=no effect, 1.0=completely black)
uniform float pixel_width;
uniform float pixel_height;
uniform float blur_strength;
uniform float bloom_strength;
uniform int afterglow_duration_ms;
uniform int afterglow_curve;
uniform int tint_mode;
uniform float tint_strength;
uniform float dt_ms;
uniform texture2d texture_accum_prev;
uniform float output_height;  // Source render height (plugin output)
uniform float canvas_height;  // OBS canvas height (final output) for canvas-space scanlines
uniform float source_width;   // Original C64 source width (e.g., 384)
uniform float source_height;  // Original C64 source height (e.g., 270/272)

sampler_state textureSampler {
    Filter   = Point;  // Use nearest neighbor for pixel-perfect scaling
    AddressU = Clamp;
    AddressV = Clamp;
    MinLOD   = 0.0;
    MaxLOD   = 0.0;
};

// Point sampler for accumulation texture - prevents interpolation artifacts
// that cause jagged/blotchy afterglow decay
sampler_state point_clamp {
    Filter   = Point;
    AddressU = Clamp;
    AddressV = Clamp;
    MinLOD   = 0.0;
    MaxLOD   = 0.0;
};

sampler_state linear_clamp {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

struct VertDataOut {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
    // Note: screen_pos removed - we'll use v_in.pos directly in pixel shader
    // which gives us the actual rasterized fragment position
};

// CRT phosphor afterglow: max-based persistence model
// Matched to CPU implementation for equivalent output:
//   output = max(current, prev * decay)
// Time constants use same ratios as CPU implementation:
//   tau_r = 1.35, tau_g = 1.0, tau_b = 0.75 (red persists longest, blue fastest)
float3 ApplyAfterglow(float2 uv, float3 current_rgb)
{
    // Use point sampling to avoid interpolation artifacts at pixel boundaries
    // Linear filtering causes color bleeding that manifests as jagged/blotchy decay
    float4 prev = texture_accum_prev.Sample(point_clamp, uv);

    // Duration in seconds (clamp to at least 0.001s to prevent div-by-zero)
    float duration_s = max(float(afterglow_duration_ms), 1.0) / 1000.0;

    // Pre-compute dt/1000 once
    float dt_s = dt_ms / 1000.0;

    // Per-channel time constants (seconds) - MATCH CPU EXACTLY
    // Scale by curve selection: 0=no scale, 1=faster (0.5x), 2=normal (1x), 3=long tail (2x)
    float curve_scale = (afterglow_curve == 0) ? 1.0 :
                        (afterglow_curve == 1) ? 0.5 :
                        (afterglow_curve == 3) ? 2.0 : 1.0;
    // Use same tau ratios as CPU: 1.35 (red), 1.0 (green), 0.75 (blue)
    float3 tau = max(float3(1.35, 1.0, 0.75) * duration_s * curve_scale, float3(0.001, 0.001, 0.001));

    // Compute decay factor per channel for this frame (0..1)
    // CPU uses: curve 0 = linear (1 - dt/tau), curves 1-3 = exponential exp(-dt/tau)
    float3 decay;
    if (afterglow_curve == 0) {
        // Linear decay (matches CPU curve 0)
        decay = saturate(float3(1.0, 1.0, 1.0) - dt_s / tau);
    } else {
        // Exponential decay (matches CPU curves 1-3)
        decay = exp(-dt_s / tau);
    }

    // === MAX-BASED PERSISTENCE (matches CPU exactly) ===
    // CPU: output = max(current, prev * decay)
    // This is the key difference from EMA - preserves sharp leading edge, smooth trailing
    float3 decayed_prev = prev.rgb * decay;
    float3 persisted = max(current_rgb, decayed_prev);

    return saturate(persisted);
}

VertDataOut VSDefault(VertData v_in)
{
    VertDataOut vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float4 PSDefault(VertDataOut v_in) : TARGET
{
    // Clamp UV coordinates to valid range to prevent out-of-bounds sampling
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    // Store original UV for scanline calculation (before any snapping)
    float2 original_uv = uv;

    // === SHARP PIXEL EXPANSION (UV SNAPPING) ===
    // When pixel_width/height > 1, we need to snap UV coordinates to exact texel centers
    // to achieve crisp integer-multiple pixel expansion without any blur.
    // This maps each output pixel to the center of the corresponding source texel.
    if (blur_strength == 0.0f && source_width > 0.0f && source_height > 0.0f) {
        // Convert UV to source texel coordinate
        float src_x = uv.x * source_width;
        float src_y = uv.y * source_height;
        // Snap to texel center: floor to get texel index, add 0.5 for center
        src_x = floor(src_x) + 0.5f;
        src_y = floor(src_y) + 0.5f;
        // Convert back to UV space
        uv.x = src_x / source_width;
        uv.y = src_y / source_height;
    }

    // === PIXEL GEOMETRY WITH BLUR CONTROL ===
    // Pixel geometry scaling is handled by matrix transforms
    // Here we apply blur control for crisp vs soft scaling
    float4 color;
    if (blur_strength > 0.0f) {
        // Gaussian-style blur with multiple taps for soft scaling
        // Use precise float for DirectX 11 compatibility
        float blur_radius = blur_strength * 0.003f;

        // Clamp UV coordinates to prevent sampling outside texture bounds
        // This fixes garbled output on Windows DirectX 11
        float2 uv_center = uv;
        float2 uv_right = saturate(uv + float2(blur_radius, 0.0f));
        float2 uv_left = saturate(uv - float2(blur_radius, 0.0f));
        float2 uv_up = saturate(uv + float2(0.0f, blur_radius));
        float2 uv_down = saturate(uv - float2(0.0f, blur_radius));
        float2 uv_tr = saturate(uv + float2(blur_radius, blur_radius));
        float2 uv_bl = saturate(uv - float2(blur_radius, blur_radius));
        float2 uv_tl = saturate(uv + float2(-blur_radius, blur_radius));
        float2 uv_br = saturate(uv + float2(blur_radius, -blur_radius));

        // 9-tap gaussian-style sampling with clamped coordinates
        color  = image.Sample(textureSampler, uv_center) * 0.25f;  // Center (main weight)
        color += image.Sample(textureSampler, uv_right) * 0.125f;  // Right
        color += image.Sample(textureSampler, uv_left) * 0.125f;   // Left
        color += image.Sample(textureSampler, uv_up) * 0.125f;     // Up
        color += image.Sample(textureSampler, uv_down) * 0.125f;   // Down
        color += image.Sample(textureSampler, uv_tr) * 0.0625f;    // Top-right
        color += image.Sample(textureSampler, uv_bl) * 0.0625f;    // Bottom-left
        color += image.Sample(textureSampler, uv_tl) * 0.0625f;    // Top-left
        color += image.Sample(textureSampler, uv_br) * 0.0625f;    // Bottom-right
    } else {
        // Precise sampling for crisp scaling (no blur)
        color = image.Sample(textureSampler, uv);
    }

    // === SCANLINES EFFECT (SOURCE-SPACE FOR PERFECT UNIFORMITY) ===
    // Renders scanlines based on the source pixel row being rendered.
    // Since the plugin scales the source to integer multiples (e.g., 4× for Wide),
    // we compute which output row we're in and apply the pattern directly.
    // scan_line_distance: controls gap size (0.0-2.0)
    // scan_line_strength: darkness of gaps (0.0=no effect, 1.0=completely black)
    // IMPORTANT: Use original_uv (pre-snapping) for scanline calculation!
    // The snapped UV quantizes to source texels, causing all output rows mapping to the
    // same source row to get identical UV values - breaking the scanline pattern.
    if (scan_line_distance > 0.0f && scan_line_strength > 0.0f) {
        // Use ORIGINAL UV Y coordinate (before snapping) multiplied by OUTPUT height
        // output_height is the plugin's scaled render height (e.g., 240*4=960 for NTSC Wide)
        // This gives us the exact rendered pixel row
        int output_row = int(original_uv.y * max(output_height, 1.0f));

        // Determine scanline pattern based on distance setting
        // Pattern repeats every N pixels for consistent appearance
        int total_pixels_per_unit;
        int scanline_pixels_per_unit;
        if (scan_line_distance <= 0.25f) {       // Tight: 4 bright + 1 dark
            total_pixels_per_unit = 5;
            scanline_pixels_per_unit = 4;
        } else if (scan_line_distance <= 0.5f) { // Normal: 2 bright + 1 dark
            total_pixels_per_unit = 3;
            scanline_pixels_per_unit = 2;
        } else if (scan_line_distance <= 1.0f) { // Wide: 2 bright + 2 dark
            total_pixels_per_unit = 4;
            scanline_pixels_per_unit = 2;
        } else {                                 // Extra Wide: 1 bright + 2 dark
            total_pixels_per_unit = 3;
            scanline_pixels_per_unit = 1;
        }

        // Calculate position within the scanline pattern using integer modulo
        // This eliminates floating-point precision issues entirely
        int position_in_pattern = output_row % total_pixels_per_unit;

        // Determine if this pixel is in a gap (dark) or scanline (bright)
        if (position_in_pattern >= scanline_pixels_per_unit) {
            // This pixel is in the gap portion - darken it
            color.rgb = color.rgb * (1.0f - scan_line_strength);
        }
    }

    // === OPTIMIZED CRT BLOOM EFFECT ===
    // Reduced from 16+ texture samples to 9 samples using efficient 3x3 pattern
    // Provides visually equivalent bloom with ~45% fewer texture fetches
    if (bloom_strength > 0.0f) {
        float4 center = color;
        float3 bloom_result = center.rgb;

        // Single-pass 9-tap bloom kernel with weighted falloff
        // Combines inner/medium/outer rings into one efficient sampling pass
        float radius = bloom_strength * 0.003f;  // Unified radius (tuned for visual match)
        float diag = radius * 0.707f;            // Diagonal offset (1/sqrt(2))

        // Pre-compute clamped sample coordinates
        float2 uv_r = saturate(uv + float2(radius, 0.0f));
        float2 uv_l = saturate(uv - float2(radius, 0.0f));
        float2 uv_u = saturate(uv + float2(0.0f, radius));
        float2 uv_d = saturate(uv - float2(0.0f, radius));
        float2 uv_tr = saturate(uv + float2(diag, diag));
        float2 uv_tl = saturate(uv + float2(-diag, diag));
        float2 uv_br = saturate(uv + float2(diag, -diag));
        float2 uv_bl = saturate(uv - float2(diag, diag));

        // 9-tap weighted sampling: center (0.20) + cardinal (0.12 each) + diagonal (0.07 each)
        // Weights sum to 1.0 for proper normalization
        float4 bloom_sum = center * 0.20f;
        bloom_sum += image.Sample(textureSampler, uv_r) * 0.12f;
        bloom_sum += image.Sample(textureSampler, uv_l) * 0.12f;
        bloom_sum += image.Sample(textureSampler, uv_u) * 0.12f;
        bloom_sum += image.Sample(textureSampler, uv_d) * 0.12f;
        bloom_sum += image.Sample(textureSampler, uv_tr) * 0.07f;
        bloom_sum += image.Sample(textureSampler, uv_tl) * 0.07f;
        bloom_sum += image.Sample(textureSampler, uv_br) * 0.07f;
        bloom_sum += image.Sample(textureSampler, uv_bl) * 0.07f;

        // CRT phosphor response (red persists longer, blue decays faster)
        float3 phosphor_response = float3(1.2f, 1.0f, 0.8f);

        // Smooth bloom intensity based on luminance (no hard threshold)
        float center_luma = dot(center.rgb, float3(0.299f, 0.587f, 0.114f));
        float bloom_factor = smoothstep(0.0f, 1.0f, center_luma);

        // Apply phosphor response to bloom samples
        float3 combined_bloom = bloom_sum.rgb * phosphor_response;

        // Smooth bloom intensity scaling
        float bloom_intensity = bloom_factor * bloom_strength * 2.0f;

        // Add bloom as additive glow (key to realistic CRT bloom)
        bloom_result = center.rgb + (combined_bloom * bloom_intensity);

        // Simulate phosphor saturation (tone mapping to prevent clipping)
        bloom_result = bloom_result / (1.0f + bloom_result * 0.3f);

        // Subtle bloom bleeding for all pixels (characteristic of CRT)
        float subtle_bloom = bloom_strength * 0.15f;
        bloom_result = lerp(bloom_result, bloom_result + bloom_sum.rgb * subtle_bloom, bloom_strength * 0.2f);

        color.rgb = bloom_result;
    }

    // === SCREEN TINT EFFECT ===
    // Emulate 1980s monochrome CRTs: first convert to monochrome, then apply tint
    // Apply BEFORE afterglow to prevent brightness feedback loops
    if (tint_mode > 0) {
        // Step 1: ALWAYS convert to monochrome first (grayscale) using proper luminance calculation
        float luminance = dot(color.rgb, float3(0.299f, 0.587f, 0.114f));
        float3 monochrome = float3(luminance, luminance, luminance);

        // Step 2: Apply tint based on mode and strength
        float3 tinted_color;

        if (tint_mode == 1) { // Amber CRT
            float3 amber_tint = float3(1.0f, 0.75f, 0.3f);
            // Blend between pure monochrome and tinted monochrome based on tint_strength
            float3 tinted_mono = monochrome * amber_tint;
            tinted_color = lerp(monochrome, tinted_mono, saturate(tint_strength));
        }
        else if (tint_mode == 2) { // Green CRT
            float3 green_tint = float3(0.5f, 0.95f, 0.35f);
            // Blend between pure monochrome and tinted monochrome based on tint_strength
            float3 tinted_mono = monochrome * green_tint;
            tinted_color = lerp(monochrome, tinted_mono, saturate(tint_strength));
        }
        else if (tint_mode == 3) { // Pure Monochrome
            // Always pure monochrome (tint_strength has no effect)
            tinted_color = monochrome;
        }
        else {
            // tint_mode == 0 (None) - should not reach here, but fallback to original
            tinted_color = color.rgb;
        }

        color.rgb = tinted_color;
    }

    // === AFTERGLOW EFFECT ===
    // CRT phosphor afterglow: exponential smoothing persistence model
    // Applied AFTER tint to ensure consistent brightness levels
    if (afterglow_duration_ms > 0) {
        color.rgb = ApplyAfterglow(uv, color.rgb);
    }

    // Ensure final color is properly clamped for DirectX 11
    return saturate(color);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = PSDefault(v_in);
    }
}

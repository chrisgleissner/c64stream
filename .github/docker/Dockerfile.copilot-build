# Minimal Ubuntu container for Copilot agent builds
# This is optimized for fast startup and contains only essential build dependencies
# No OBS, no GUI libraries - those are downloaded by the build system when needed

FROM ubuntu:24.04

LABEL org.opencontainers.image.title="C64 Stream Copilot Build Environment"
LABEL org.opencontainers.image.description="Minimal Ubuntu container for fast Copilot agent builds"
LABEL org.opencontainers.image.source="https://github.com/chrisgleissner/c64stream"
LABEL org.opencontainers.image.licenses="GPL-2.0-or-later"

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install only essential build dependencies
# OBS and Qt6 are intentionally excluded - they're downloaded by the build system
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        # Core build tools
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        git \
        zsh \
        ccache \
        # Required for scripts and REST client
        curl \
        libcurl4-openssl-dev \
        # SIMD optimizations
        libsimde-dev \
        # Python for tests
        python3 \
        python3-pip \
        # Utilities
        ca-certificates \
        wget \
        gnupg \
        lsb-release \
        jq \
        file \
        xz-utils && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install clang-format 21 via official LLVM script
RUN curl -sSL https://apt.llvm.org/llvm.sh | bash -s -- 21 all && \
    update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-21 2100 --force && \
    update-alternatives --set clang-format /usr/bin/clang-format-21

# Install Python packages for testing
RUN python3 -m pip install --no-cache-dir --break-system-packages \
        gersemi \
        pytest \
        numpy

# Configure ccache for optimal build caching
RUN mkdir -p /usr/local/bin && \
    ln -sf /usr/bin/ccache /usr/local/bin/gcc && \
    ln -sf /usr/bin/ccache /usr/local/bin/g++ && \
    ln -sf /usr/bin/ccache /usr/local/bin/cc && \
    ln -sf /usr/bin/ccache /usr/local/bin/c++

# Set up working directory
WORKDIR /workspace

# Configure Git to avoid issues with file ownership in containers
RUN git config --global --add safe.directory /workspace && \
    git config --global --add safe.directory '*'

# Set default shell to bash for compatibility
SHELL ["/bin/bash", "-c"]

# Verify installations work correctly
RUN echo "=== Minimal Build Environment Ready ===" && \
    echo "✅ CMake: $(cmake --version | head -1)" && \
    echo "✅ Ninja: $(ninja --version)" && \
    echo "✅ ccache: $(ccache --version | head -1)" && \
    echo "✅ clang-format: $(clang-format --version | head -1)" && \
    echo "✅ curl: $(curl --version | head -1)" && \
    echo "✅ zsh: $(zsh --version)" && \
    echo "✅ Python: $(python3 --version)" && \
    echo "" && \
    echo "Note: OBS and Qt6 are downloaded automatically by the build system" && \
    echo "This keeps the container small and startup fast for Copilot agents"

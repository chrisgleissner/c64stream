# Pre-built RHEL/CentOS Stream container with OBS Studio and Qt6 dependencies
# Uses CentOS Stream 9 as a freely available RHEL-compatible base
# This dramatically speeds up CI builds by avoiding lengthy DNF installations
#
# NOTE: E2E tests are NOT supported on RHEL due to OBS version constraints:
# - RPM Fusion provides OBS 30.0.0 which has known recording issues
# - Flatpak OBS 32.x works but cannot load host plugins due to sandboxing
# - Building OBS from source requires FFmpeg 6.1+ (RHEL only has 5.x)
# Build and load tests work fine; only E2E (recording) is excluded.

FROM quay.io/centos/centos:stream9

LABEL org.opencontainers.image.title="C64 Stream RHEL Build Environment"
LABEL org.opencontainers.image.description="Pre-built CentOS Stream 9 container with OBS Studio and Qt6 for fast CI builds"
LABEL org.opencontainers.image.source="https://github.com/chrisgleissner/c64stream"
LABEL org.opencontainers.image.licenses="GPL-2.0-or-later"

# Set timezone
ENV TZ=UTC

# Enable EPEL and RPM Fusion repositories for OBS and additional packages
RUN dnf install -y epel-release && \
    dnf install -y --nogpgcheck \
        https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-9.noarch.rpm \
        https://mirrors.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-9.noarch.rpm && \
    dnf config-manager --enable crb

# Install build dependencies and OBS Studio
RUN dnf install -y \
        gcc \
        gcc-c++ \
        cmake \
        ninja-build \
        pkg-config \
        git \
        zsh \
        jq \
        ccache \
        file \
        rpm-build \
        xz \
        net-tools \
        mesa-libGL \
        mesa-dri-drivers \
        mesa-libGLU \
        libxkbcommon-x11 \
        xcb-util-wm \
        dejavu-sans-fonts \
        mesa-libGLES-devel \
        obs-studio \
        obs-studio-devel \
        obs-studio-libs \
        obs-studio-plugin-x264 \
        qt6-qtbase-devel \
        qt6-qtsvg \
        ffmpeg \
        ffmpeg-devel \
        x264-devel \
        libcurl-devel \
        mbedtls-devel \
        jansson-devel \
        luajit-devel \
        python3-devel \
        libX11-devel \
        libxcb-devel \
        libXcomposite-devel \
        libXinerama-devel \
        pulseaudio-libs-devel \
        alsa-lib-devel \
        jack-audio-connection-kit-devel \
        speexdsp-devel \
        libv4l-devel \
        libva-devel \
        libdrm-devel \
        libpciaccess-devel \
        wayland-devel \
        srt-devel \
        json-devel \
        uthash-devel

# Install Python dependencies for E2E tests
RUN dnf install -y \
        python3 \
        python3-pip \
        python3-numpy \
        python3-opencv \
        python3-pillow \
        python3-pyyaml \
        xorg-x11-server-Xvfb \
        pipewire-pulseaudio \
        pulseaudio-utils

# Clean up DNF cache
RUN dnf clean all

# Verify OBS installation
RUN obs --version || echo "OBS Studio installed (version check may fail in container)"

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]

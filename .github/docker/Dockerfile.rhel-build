# Pre-built RHEL/CentOS Stream container with OBS Studio 30+ and Qt6 dependencies
# Uses CentOS Stream 9 as a freely available RHEL-compatible base
# OBS is built from source to get version 30+ (RPM Fusion only has 30.0.0 with recording issues)
# This dramatically speeds up CI builds by avoiding lengthy DNF installations

FROM quay.io/centos/centos:stream9

LABEL org.opencontainers.image.title="C64 Stream RHEL Build Environment"
LABEL org.opencontainers.image.description="Pre-built CentOS Stream 9 container with OBS Studio 30+ and Qt6 for fast CI builds"
LABEL org.opencontainers.image.source="https://github.com/chrisgleissner/c64stream"
LABEL org.opencontainers.image.licenses="GPL-2.0-or-later"

# Set timezone
ENV TZ=UTC

# Enable EPEL and RPM Fusion repositories for additional packages
RUN dnf install -y epel-release && \
    dnf install -y --nogpgcheck \
        https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-9.noarch.rpm \
        https://mirrors.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-9.noarch.rpm && \
    dnf config-manager --enable crb

# Install build dependencies (OBS will be built from source)
RUN dnf install -y \
        gcc \
        gcc-c++ \
        cmake \
        ninja-build \
        pkg-config \
        git \
        zsh \
        jq \
        ccache \
        file \
        rpm-build \
        xz \
        net-tools \
        mesa-libGL \
        mesa-libGL-devel \
        mesa-dri-drivers \
        mesa-libGLU \
        mesa-libGLU-devel \
        libxkbcommon-x11 \
        libxkbcommon-devel \
        xcb-util-wm \
        dejavu-sans-fonts \
        mesa-libGLES-devel \
        qt6-qtbase-devel \
        qt6-qtbase-private-devel \
        qt6-qtsvg-devel \
        qt6-qtwayland \
        ffmpeg \
        ffmpeg-devel \
        x264-devel \
        libcurl-devel \
        mbedtls-devel \
        jansson-devel \
        luajit-devel \
        python3-devel \
        libX11-devel \
        libxcb-devel \
        libXcomposite-devel \
        libXinerama-devel \
        pulseaudio-libs-devel \
        alsa-lib-devel \
        jack-audio-connection-kit-devel \
        speexdsp-devel \
        libv4l-devel \
        libva-devel \
        libdrm-devel \
        libpciaccess-devel \
        wayland-devel \
        srt-devel \
        json-devel \
        uthash-devel \
        pipewire-devel \
        freetype-devel \
        fontconfig-devel \
        swig

# Build OBS Studio 32.0.4 from source (fixes recording issues in 30.0.0)
# Disabled optional features to minimize build time and dependencies
ENV OBS_VERSION=32.0.4
RUN cd /tmp && \
    git clone --recursive --depth 1 --branch ${OBS_VERSION} https://github.com/obsproject/obs-studio.git && \
    cd obs-studio && \
    mkdir build && cd build && \
    cmake -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DENABLE_BROWSER=OFF \
        -DENABLE_VST=OFF \
        -DENABLE_VLC=OFF \
        -DENABLE_SCRIPTING=OFF \
        -DENABLE_AJA=OFF \
        -DENABLE_WEBRTC=OFF \
        -DENABLE_NEW_MPEGTS_OUTPUT=OFF \
        -DENABLE_PLUGINS=ON \
        -DENABLE_UI=ON \
        .. && \
    ninja -j$(nproc) && \
    ninja install && \
    ldconfig && \
    cd / && rm -rf /tmp/obs-studio

# Install Python dependencies for E2E tests
RUN dnf install -y \
        python3 \
        python3-pip \
        python3-numpy \
        python3-opencv \
        python3-pillow \
        python3-pyyaml \
        xorg-x11-server-Xvfb \
        pipewire-pulseaudio \
        pulseaudio-utils

# Clean up DNF cache
RUN dnf clean all

# Verify OBS installation
RUN obs --version || echo "OBS Studio installed (version check may fail in container)"

# Set working directory
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]

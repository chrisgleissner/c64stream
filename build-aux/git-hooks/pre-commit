#!/bin/bash
# Pre-commit hook to auto-format staged clang-managed source files.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_files=()
while IFS= read -r -d '' path; do
    staged_files+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.c' '*.cpp' '*.h' '*.hpp' '*.m' '*.mm')

if [ ${#staged_files[@]} -eq 0 ]; then
    echo "✅ No clang-formatted source files staged"
    exit 0
fi

echo "🔧 Auto-formatting staged source files with clang-format..."
"$repo_root/build-aux/run-clang-format" "${staged_files[@]}"

git add -- "${staged_files[@]}"

echo "✅ Formatted and re-staged staged source files"
exit 0

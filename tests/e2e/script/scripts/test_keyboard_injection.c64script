# Test keyboard injection commands
# Validates TYPE and KEY commands

# Test 1: Type simple text
TYPE "LIST"
WAIT 200ms

# Test 2: Type with carriage return
TYPE "LOAD\"*\",8,1\r"
WAIT 200ms

# Test 3: Type multiple lines
TYPE "10 PRINT \"HELLO\"\r"
WAIT 100ms
TYPE "20 GOTO 10\r"
WAIT 100ms
TYPE "RUN\r"
WAIT 200ms

# Test 4: Type with escape sequences
TYPE "POKE 53280,0\r"
WAIT 200ms

# Test 5: KEY command with symbolic key names
KEY RETURN
WAIT 100ms

KEY RUNSTOP
WAIT 100ms

KEY HOME
WAIT 100ms

KEY CLEAR
WAIT 100ms

# Test 6: Cursor keys
KEY CURSOR_UP
WAIT 100ms

KEY CURSOR_DOWN
WAIT 100ms

KEY CURSOR_LEFT
WAIT 100ms

KEY CURSOR_RIGHT
WAIT 100ms

# Test 7: KEY with numeric value (raw byte)
KEY 13
WAIT 100ms

# Test 8: KEY with hex value
KEY $0D
WAIT 100ms

STOP

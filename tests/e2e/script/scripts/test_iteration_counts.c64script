REM Test multiple iteration counts and step values
REM Validates FOR loop counting with various configurations

REM Test 1: Simple forward counting (1 to 5)
for i = 1 to 5
    effect "Sharp Pixels"
    wait 50ms
next i

REM Test 2: Counting with step value (0 to 10, step 2)
for j = 0 to 10 step 2
    palette "colodore"
    wait 50ms
next j
REM Should execute 6 times: 0, 2, 4, 6, 8, 10

REM Test 3: Backward counting (10 to 1, step -1)
for k = 10 to 1 step -1
    effect "Soft CRT"
    wait 50ms
next k
REM Should execute 10 times

REM Test 4: Backward counting with step -2
for l = 20 to 10 step -2
    palette "pepto_ntsc"
    wait 50ms
next l
REM Should execute 6 times: 20, 18, 16, 14, 12, 10

REM Test 5: Zero iterations (start > end with positive step)
for m = 10 to 1
    REM This should not execute
    effect "SHOULD_NOT_SEE"
next m

REM Test 6: Large iteration count
count = 0
for n = 1 to 100
    count = count + 1
    if count = 10 or count = 50 or count = 100 then
        effect "Light Scanlines"
        wait 50ms
    endif
next n

REM Test 7: Fractional step values
for o = 0 to 2 step 0.5
    palette "vice_new"
    wait 50ms
next o
REM Should execute 5 times: 0, 0.5, 1.0, 1.5, 2.0

REM Test 8: Nested loops with different step values
for p = 2 to 8 step 2
    for q = 10 to 5 step -1
        effect "CRT Monitor Warm"
        wait 25ms
    next q
next p
REM Outer: 4 times (2,4,6,8), Inner: 6 times (10,9,8,7,6,5)
REM Total: 24 executions

stop

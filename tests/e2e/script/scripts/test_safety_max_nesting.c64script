REM Test maximum nesting depth for loops
REM This should hit the nesting limit (typically 16 levels)

REM Attempt to nest 20 FOR loops (should fail at limit)
FOR L1 = 1 TO 2
FOR L2 = 1 TO 2
FOR L3 = 1 TO 2
FOR L4 = 1 TO 2
FOR L5 = 1 TO 2
FOR L6 = 1 TO 2
FOR L7 = 1 TO 2
FOR L8 = 1 TO 2
FOR L9 = 1 TO 2
FOR L10 = 1 TO 2
FOR L11 = 1 TO 2
FOR L12 = 1 TO 2
FOR L13 = 1 TO 2
FOR L14 = 1 TO 2
FOR L15 = 1 TO 2
FOR L16 = 1 TO 2
FOR L17 = 1 TO 2
REM Should fail here or earlier
EFFECT Sharp Pixels
WAIT 10ms
NEXT L17
NEXT L16
NEXT L15
NEXT L14
NEXT L13
NEXT L12
NEXT L11
NEXT L10
NEXT L9
NEXT L8
NEXT L7
NEXT L6
NEXT L5
NEXT L4
NEXT L3
NEXT L2
NEXT L1
STOP

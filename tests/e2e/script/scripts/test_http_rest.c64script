REM Test HTTP REST API calls
REM Validates HTTP GET, POST, PUT, DELETE, PATCH

REM Test 1: HTTP GET request
HTTP GET "http://localhost:8064/v1/version" STATUS STATUS_CODE RESPONSE RESP$
WAIT 100ms
LOG "GET status: " + STATUS_CODE

REM Test 2: HTTP GET with status check
HTTP GET "http://localhost:8064/v1/info" STATUS CODE
IF CODE = 200 THEN
    EFFECT Sharp Pixels
ENDIF
WAIT 100ms

REM Test 3: HTTP POST request with body
BODY$ = "{\"command\":\"reset\"}"
HTTP POST "http://localhost:8064/v1/command" BODY BODY$ STATUS POST_STATUS
WAIT 100ms

REM Test 4: HTTP POST with headers and body
HEADERS${"Content-Type"} = "application/json"
DATA$ = "{\"value\":42}"
HTTP POST "http://localhost:8064/v1/data" HEADERS HEADERS$ BODY DATA$ STATUS S RESPONSE R$
WAIT 100ms
LOG "POST response: " + R$

REM Test 5: HTTP PUT request
HTTP PUT "http://localhost:8064/v1/machine:reset" STATUS PUT_CODE
WAIT 100ms

REM Test 6: HTTP DELETE request
HTTP DELETE "http://localhost:8064/v1/resource/123" STATUS DEL_CODE
WAIT 100ms

REM Test 7: HTTP PATCH request
PATCH_BODY$ = "{\"field\":\"updated\"}"
HTTP PATCH "http://localhost:8064/v1/resource/456" BODY PATCH_BODY$ STATUS PATCH_CODE
WAIT 100ms

REM Test 8: HTTP GET in conditional
HTTP GET "http://localhost:8064/v1/status" STATUS API_STATUS RESPONSE API_RESP$
IF API_STATUS = 200 THEN
    LOG "API is available"
    PALETTE colodore
ELSE
    LOG "API error: " + API_STATUS
    PALETTE pepto_ntsc
ENDIF
WAIT 100ms

REM Test 9: Multiple sequential API calls
FOR I = 1 TO 3
    HTTP GET "http://localhost:8064/v1/version" STATUS S
    LOG "Call " + I + " status: " + S
    WAIT 50ms
NEXT I

REM Test 10: Complex API workflow
HTTP GET "http://localhost:8064/v1/info" STATUS INFO_CODE RESPONSE INFO$
IF INFO_CODE = 200 THEN
    CMD$ = "{\"action\":\"start\"}"
    HTTP POST "http://localhost:8064/v1/command" BODY CMD$ STATUS CMD_CODE
    IF CMD_CODE = 200 THEN
        LOG "Command executed successfully"
    ENDIF
ENDIF

STOP

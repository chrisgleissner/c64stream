# Test user-defined functions
# Validates FUNCTION/ENDFUNCTION with parameters and return values

# Test 1: Simple function with no parameters
FUNCTION GET_CONSTANT()
    RETURN 42
ENDFUNCTION

CONSTANT = GET_CONSTANT()
LOG "Constant: " + CONSTANT
WAIT 100ms

# Test 2: Function with one parameter
FUNCTION DOUBLE(X)
    RETURN X * 2
ENDFUNCTION

DOUBLED = DOUBLE(21)
LOG "Double of 21: " + DOUBLED
WAIT 100ms

# Test 3: Function with multiple parameters
FUNCTION ADD(A, B)
    RETURN A + B
ENDFUNCTION

SUM = ADD(10, 20)
LOG "10 + 20 = " + SUM
WAIT 100ms

# Test 4: Function with string parameter
FUNCTION GREET(NAME$)
    RETURN "Hello, " + NAME$ + "!"
ENDFUNCTION

GREETING$ = GREET("Alice")
LOG GREETING$
WAIT 100ms

# Test 5: Function with local variables
FUNCTION CALCULATE(X, Y)
    TEMP = X * 2
    RESULT = TEMP + Y
    RETURN RESULT
ENDFUNCTION

VALUE = CALCULATE(5, 10)
LOG "Calculate(5, 10): " + VALUE
WAIT 100ms

# Test 6: Function with conditional
FUNCTION MAX(A, B)
    IF A > B THEN
        RETURN A
    ELSE
        RETURN B
    ENDIF
ENDFUNCTION

MAXIMUM = MAX(15, 10)
LOG "MAX(15, 10): " + MAXIMUM
WAIT 100ms

# Test 7: Function with loop
FUNCTION FACTORIAL(N)
    IF N <= 1 THEN
        RETURN 1
    ENDIF
    RESULT = 1
    FOR I = 2 TO N
        RESULT = RESULT * I
    NEXT I
    RETURN RESULT
ENDFUNCTION

FACT5 = FACTORIAL(5)
LOG "Factorial(5): " + FACT5
WAIT 100ms

# Test 8: Recursive function (careful with depth)
FUNCTION FIB(N)
    IF N <= 1 THEN
        RETURN N
    ENDIF
    RETURN FIB(N - 1) + FIB(N - 2)
ENDFUNCTION

FIB5 = FIB(5)
LOG "Fibonacci(5): " + FIB5
WAIT 100ms

# Test 9: Function calling another function
FUNCTION SQUARE(X)
    RETURN X * X
ENDFUNCTION

FUNCTION SUM_OF_SQUARES(A, B)
    RETURN SQUARE(A) + SQUARE(B)
ENDFUNCTION

SOS = SUM_OF_SQUARES(3, 4)
LOG "3^2 + 4^2 = " + SOS
WAIT 100ms

# Test 10: Function with effect
FUNCTION APPLY_EFFECT_AND_WAIT(EFFECT_NAME$, DURATION)
    EFFECT EFFECT_NAME$
    WAIT DURATION
    RETURN 1
ENDFUNCTION

SUCCESS = APPLY_EFFECT_AND_WAIT("Sharp Pixels", 0.2)
IF SUCCESS = 1 THEN
    LOG "Effect applied successfully"
ENDIF

# Test 11: Function in loop
FOR J = 1 TO 3
    RESULT = DOUBLE(J)
    LOG "Double of " + J + " is " + RESULT
    WAIT 50ms
NEXT J

STOP

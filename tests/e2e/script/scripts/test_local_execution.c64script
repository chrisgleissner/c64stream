# Test local program execution
# Validates RUNLOCAL command

# Test 1: Run local command without arguments
RUNLOCAL "echo" ARGS "Hello World" STATUS EXIT_CODE OUTPUT OUT$
WAIT 100ms
LOG "Echo output: " + OUT$

# Test 2: Run local command with status check
RUNLOCAL "true" STATUS SUCCESS_CODE
IF SUCCESS_CODE = 0 THEN
    EFFECT Sharp Pixels
ENDIF
WAIT 100ms

# Test 3: Run command that fails
RUNLOCAL "false" STATUS FAIL_CODE
IF FAIL_CODE <> 0 THEN
    LOG "Command failed as expected"
ENDIF
WAIT 100ms

# Test 4: Run command with arguments
RUNLOCAL "ls" ARGS "-la" STATUS LS_CODE OUTPUT LS_OUT$
WAIT 100ms
LOG "Directory listing length: " + LEN(LS_OUT$)

# Test 5: Conditional execution based on output
RUNLOCAL "date" ARGS "+%Y" STATUS D_CODE OUTPUT YEAR$
IF VAL(YEAR$) >= 2024 THEN
    PALETTE colodore
ENDIF
WAIT 100ms

# Test 6: Execute script file
RUNLOCAL "/bin/sh" ARGS "-c 'echo test'" STATUS SH_CODE OUTPUT SH_OUT$
WAIT 100ms

# Test 7: Execute with error handling
RUNLOCAL "nonexistent_command" STATUS ERR_CODE OUTPUT ERR_OUT$
IF ERR_CODE <> 0 THEN
    LOG "Error: " + ERR_OUT$
    EFFECT Soft CRT
ENDIF
WAIT 100ms

# Test 8: Chain multiple local executions
RUNLOCAL "echo" ARGS "Step 1" STATUS S1 OUTPUT O1$
LOG O1$
WAIT 50ms

RUNLOCAL "echo" ARGS "Step 2" STATUS S2 OUTPUT O2$
LOG O2$
WAIT 50ms

RUNLOCAL "echo" ARGS "Step 3" STATUS S3 OUTPUT O3$
LOG O3$
WAIT 50ms

# Test 9: Use output in subsequent operations
RUNLOCAL "expr" ARGS "10 + 20" STATUS EXPR_CODE OUTPUT RESULT$
NUM = VAL(RESULT$)
IF NUM = 30 THEN
    LOG "Calculation correct: " + NUM
ENDIF
WAIT 100ms

# Test 10: Complex workflow with local execution
RUNLOCAL "date" ARGS "+%s" STATUS T_CODE OUTPUT TIMESTAMP$
WRITEFILE "execution_log.txt", "Executed at: " + TIMESTAMP$, APPEND

STOP

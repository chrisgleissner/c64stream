# Test arrays and maps
# Validates DIM, array access, and map access

# Test 1: Declare numeric array
DIM VALUES(10)
WAIT 50ms

# Test 2: Assign to array elements
VALUES(0) = 100
VALUES(1) = 200
VALUES(2) = 300
WAIT 50ms

# Test 3: Read from array
FIRST = VALUES(0)
IF FIRST = 100 THEN
    EFFECT Sharp Pixels
ENDIF
WAIT 100ms

# Test 4: Array in loop
FOR I = 0 TO 5
    VALUES(I) = I * 10
    WAIT 20ms
NEXT I

# Test 5: Sum array elements
SUM = 0
FOR J = 0 TO 5
    SUM = SUM + VALUES(J)
    WAIT 20ms
NEXT J
LOG "Array sum: " + SUM

# Test 6: String array
DIM NAMES$(5)
NAMES$(0) = "Alice"
NAMES$(1) = "Bob"
NAMES$(2) = "Charlie"
WAIT 50ms

# Test 7: Access string array
FIRST_NAME$ = NAMES$(0)
LOG "First name: " + FIRST_NAME$
WAIT 100ms

# Test 8: Map with string keys
CONFIG${"host"} = "192.168.1.64"
CONFIG${"path"} = "/v1/api"
CONFIG{"port"} = 8080
CONFIG{"timeout"} = 5000
WAIT 50ms

# Test 9: Read from map
HOST$ = CONFIG${"host"}
PORT = CONFIG{"port"}
LOG "Server: " + HOST$ + ":" + PORT
WAIT 100ms

# Test 10: Map in conditional
IF CONFIG{"port"} = 8080 THEN
    PALETTE colodore
ELSE
    PALETTE pepto_ntsc
ENDIF
WAIT 100ms

# Test 11: Iterate with array
DIM PALETTES$(3)
PALETTES$(0) = "colodore"
PALETTES$(1) = "pepto_ntsc"
PALETTES$(2) = "vice_new"

FOR K = 0 TO 2
    PALETTE PALETTES$(K)
    WAIT 100ms
NEXT K

# Test 12: Nested arrays (2D simulation)
DIM ROW1(5)
DIM ROW2(5)
ROW1(0) = 1
ROW1(1) = 2
ROW2(0) = 10
ROW2(1) = 20
WAIT 50ms

# Test 13: Array bounds
DIM SMALL(2)
SMALL(0) = 100
SMALL(1) = 200
SMALL(2) = 300
LAST = SMALL(2)
LOG "Last element: " + LAST

STOP

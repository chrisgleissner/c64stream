# C64 Stream E2E Test Artifacts
# These are generated during testing and should not be committed

# Python bytecode cache
__pycache__/
*.pyc

# Test packets
test_packets/

# Test output
test_output/

# Test results
# We keep only a small curated set of scenarios in git to avoid repo bloat.
results/*
!results/README.md
!results/ntsc_default/
!results/ntsc_default/**
!results/ntsc_default_720p/
!results/ntsc_default_720p/**
!results/ntsc_default_debug/
!results/ntsc_default_debug/**
!results/ntsc_green_monitor/
!results/ntsc_green_monitor/**
!results/ntsc_vintage_tv/
!results/ntsc_vintage_tv/**
!results/pal_default/
!results/pal_default/**

# Ignore recorded video outputs even in curated scenarios
results/**/*.mp4
results/**/*.mk4
results/**/*.mkv

# Ignore profiling artifacts even in curated scenarios
results/**/flamegraph.svg
results/**/perf.data
results/**/perf.folded
results/**/perf_report.txt
results/**/perf_record_stdout.txt
results/**/perf_record_stderr.txt
results/**/obs_log.txt
results/**/obs_log_summary.json

# Always ignore ephemeral marker files
results/**/stop_recording.marker

# Always ignore sender manifests (should never be committed, even in curated scenarios)
results/**/video_manifest.csv
results/**/audio_manifest.csv

# Tool binaries built by the Python harness (CI-safe location)
.e2e-tools/

# Scanline test output (screenshots, packets, analysis)
scanline_output/

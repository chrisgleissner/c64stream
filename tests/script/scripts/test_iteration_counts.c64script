rem Test multiple iteration counts and step values
rem Validates for loop counting with various configurations

rem Test 1: Simple forward counting (1 to 2)
for i = 1 to 2
    effect "Sharp Pixels"
    wait 50ms
next i

rem Test 2: Counting with step value (0 to 4, step 2)
for j = 0 to 4 step 2
    palette "colodore"
    wait 50ms
next j
rem Should execute 3 times: 0, 2, 4

rem Test 3: Backward counting (3 to 1, step -1)
for k = 3 to 1 step -1
    effect "Soft CRT"
    wait 50ms
next k
rem Should execute 3 times

rem Test 4: Backward counting with step -2
for l = 14 to 10 step -2
    palette "pepto_ntsc"
    wait 50ms
next l
rem Should execute 3 times: 14, 12, 10

rem Test 5: Zero iterations (start > end with positive step)
for m = 10 to 1
    rem This should not execute
    effect "SHOULD_NOT_SEE"
next m

rem Test 6: Loop with conditional
count = 0
for n = 1 to 3
    count = count + 1
    if count = 2 then
        effect "Light Scanlines"
        wait 50ms
    endif
next n

rem Test 7: Fractional step values
for o = 0 to 1 step 0.5
    palette "vice_new"
    wait 50ms
next o
rem Should execute 3 times: 0, 0.5, 1.0

rem Test 8: Nested loops with different step values
for p = 2 to 4 step 2
    for q = 5 to 3 step -1
        effect "CRT Monitor Warm"
        wait 25ms
    next q
next p
rem Outer: 2 times (2,4), Inner: 3 times (5,4,3)
rem Total: 6 executions

stop

REM U64 drives
X$ = DRIVE$(DRIVE_A, PROP_ENABLED)
WAIT 1ms
DRIVE_ON DRIVE_A
DRIVE_OFF DRIVE_A
DRIVE_RESET DRIVE_A
DRIVE_UNMOUNT DRIVE_A
DRIVE_MOUNT DRIVE_A, "c64u:/Games/game.d64", TYPE_D64, MODE_READONLY
DRIVE_ROM DRIVE_B, "c64u:/ROMs/1571.rom"
DRIVE_MODE DRIVE_B, MODE_1581
DRIVE_BUS_ID DRIVE_A, 8
STOP

REM Test ENV() built-in function
REM Validates reading OS environment variables

REM Test 1: Absent variable returns empty string
ABSENT$ = ENV("C64SCRIPT_TEST_ABSENT_VAR_XYZ")
IF ABSENT$ = "" THEN
    LOG "Test 1 passed: absent env var returns empty string"
ELSE
    LOG "Test 1 FAILED: expected empty string, got: " + ABSENT$
ENDIF

REM Test 2: Standard env var PATH is set in all environments
IF LEN(ENV("PATH")) > 0 THEN
    LOG "Test 2 passed: PATH is set"
ELSE
    LOG "Test 2 FAILED: PATH was empty"
ENDIF

REM Test 3: VAL() on absent var yields 0
NUM_VAL = VAL(ENV("C64SCRIPT_TEST_ABSENT_VAR_XYZ"))
IF NUM_VAL = 0 THEN
    LOG "Test 3 passed: VAL of absent env var is 0"
ELSE
    LOG "Test 3 FAILED: expected 0, got: " + STR$(NUM_VAL)
ENDIF

REM Test 4: Two-arg form returns default when var is absent
DEFAULTED$ = ENV("C64SCRIPT_TEST_ABSENT_VAR_XYZ", "fallback")
IF DEFAULTED$ = "fallback" THEN
    LOG "Test 4 passed: default value used when var absent"
ELSE
    LOG "Test 4 FAILED: expected 'fallback', got: " + DEFAULTED$
ENDIF

REM Test 5: Two-arg form ignores default when var is set
IF LEN(ENV("PATH", "no-path")) > 0 AND ENV("PATH", "no-path") <> "no-path" THEN
    LOG "Test 5 passed: default not used when var is set"
ELSE
    LOG "Test 5 FAILED: PATH via two-arg form was empty or returned default"
ENDIF

STOP

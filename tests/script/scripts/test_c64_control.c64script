rem Test C64 Ultimate control commands
rem Validates playsid, runprg, mountdisk, autostart, reset, reboot

rem Test 1: Play SID file with song number
playsid c64u:/Commodore/SID/tune1.sid songnr=1
wait 500ms

rem Test 2: Play different SID file
playsid c64u:/Commodore/SID/tune2.sid songnr=2
wait 500ms

rem Test 3: Play SID without explicit song number (defaults to 0)
playsid c64u:/Commodore/SID/subfolder/tune3.sid
wait 500ms

rem Test 4: Run PRG file
runprg c64u:/Commodore/PRG/game1.prg
wait 500ms

rem Test 5: Run another PRG
runprg c64u:/Commodore/PRG/demo.prg
wait 500ms

rem Test 6: Mount disk image
mountdisk c64u:/Commodore/D64/disk1.d64
wait 500ms

rem Test 7: Mount another disk
mountdisk c64u:/Commodore/D64/disk2.d64
wait 500ms

rem Test 8: Reset C64
reset
wait 500ms

rem Test 9: Reboot C64 Ultimate
reboot
wait 500ms

rem Test 10: Autostart (sends LOAD"*",8,1 and RUN)
autostart
wait 500ms

stop
